# Optional: Set either of these to run against real LLM endpoints.
# If omitted, harness automatically runs in deterministic simulation mode.

# 1. Cloud Provider (OpenAI)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# 2. Local Self-Hosted Endpoint (Ollama / vLLM)
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"
